DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# No DISCORD_DEV_GUILD_ID here — production registers commands globally.
API_BASE_URL=https://api.yourdomain.com/api/v1
BOT_SERVICE_TOKEN=           # must equal .env.api's BOT_SERVICE_TOKEN
RECONCILE_INTERVAL_MS=60000
# Only relevant when hosting on a platform that suspends idle "web services"
# (e.g. Render's free tier) and needs an inbound HTTP target for a keep-alive
# pinger — see apps/bot/src/health-server.ts. That platform typically injects
# PORT itself; leave unset on a plain always-on VM (e.g. the Oracle setup
# below), where nothing needs to ping this at all.
PORT=
