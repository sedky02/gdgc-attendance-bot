NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/meetings?retryWrites=true&w=majority
JWT_SECRET=                  # must equal the dashboard's API_JWT_SECRET on Vercel
BOT_SERVICE_TOKEN=           # must equal .env.bot's BOT_SERVICE_TOKEN
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
CORS_ORIGIN=https://your-dashboard.vercel.app
SWAGGER_ENABLED=true         # set to false to hide /docs in production
