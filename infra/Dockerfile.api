# syntax=docker/dockerfile:1
#
# Multi-stage build for @meeting-system/api, following the standard
# Turborepo pruning pattern: `turbo prune` extracts only the source and
# package.json files this app actually needs (including packages/contracts,
# a workspace:* dependency), so the installer stage's `pnpm install` only
# resolves what's relevant instead of the whole monorepo.
#
# Build from the repo root:
#   docker build -f infra/Dockerfile.api -t meeting-system-api .

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g turbo@2.3.0 pnpm@9.15.0

FROM base AS pruner
COPY . .
RUN turbo prune @meeting-system/api --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=@meeting-system/api

FROM node:20-alpine AS runner
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 api
# pnpm keeps each workspace package's own dependency symlinks in that
# package's own node_modules, not hoisted to the root — root node_modules
# alone is not enough, or `reflect-metadata` (a direct dependency of
# apps/api, not the root package.json) fails to resolve at runtime.
COPY --from=installer --chown=api:nodejs /app/node_modules ./node_modules
COPY --from=installer --chown=api:nodejs /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=installer --chown=api:nodejs /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=installer --chown=api:nodejs /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=installer --chown=api:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=installer --chown=api:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=installer --chown=api:nodejs /app/apps/api/package.json ./apps/api/package.json

USER api
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
