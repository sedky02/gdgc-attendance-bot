{
  "name": "meeting-system",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo": "turbo run dev --filter=@meeting-system/api --filter=@meeting-system/dashboard",
    "build": "turbo run build",
