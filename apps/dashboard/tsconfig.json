{
  "extends": "@meeting-system/tsconfig/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
